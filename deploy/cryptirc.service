# CryptIRC systemd service
# Place at /etc/systemd/system/cryptirc.service
#
# Install:
#   sudo cp deploy/cryptirc.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cryptirc

[Unit]
Description=CryptIRC — Encrypted IRC Client
Documentation=https://github.com/gh0st68/CryptIRC
After=network-online.target
Wants=network-online.target
# Start after Caddy so it's behind the proxy when it comes up
After=caddy.service
# If irc-core.service (see deploy/irc-core.service) is installed, start after
# it too — ordering only, no Requires=, so a daemon restart/crash never
# cascade-stops the web service or vice versa. Inert if the unit is absent.
After=irc-core.service
# Crash-loop guard ([Unit] is the current location; [Service] StartLimitInterval= is deprecated)
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=cryptirc
Group=cryptirc
WorkingDirectory=/opt/cryptirc

# The compiled binary
ExecStart=/opt/cryptirc/cryptirc

# Graceful shutdown — sends SIGTERM, waits up to 30s, then SIGKILL
ExecStop=/bin/kill -s TERM $MAINPID
TimeoutStopSec=30
KillMode=mixed

# Restart policy — always restart on crash, but not if we stop it intentionally
Restart=on-failure
RestartSec=5

# Files/dirs the service creates default to 0600/0700 (matches the at-rest secrets
# hardening), even if a code path forgets to chmod.
UMask=0077

# Environment
Environment=CRYPTIRC_DATA=/var/lib/cryptirc
Environment=CRYPTIRC_BASE_URL=https://cryptirc.yourdomain.com
Environment=CRYPTIRC_BASE_PATH=/
Environment=CRYPTIRC_PORT=9001
Environment=CRYPTIRC_FROM_EMAIL=noreply@yourdomain.com
Environment=CRYPTIRC_REGISTRATION=open
# HSTS (Strict-Transport-Security, 2 years, preload): keep "on" for a domain with a real
# (e.g. Let's Encrypt) certificate. On a bare IP / self-signed certificate set it to "off":
# there HSTS makes browsers refuse the certificate-warning click-through and locks every
# visitor out for ~2 years. The installers set this for you; unset means on.
Environment=CRYPTIRC_HSTS=on
# Secrets such as CRYPTIRC_REG_CODE belong in a root-only (chmod 600) file, not here — any
# local user can read a unit's Environment= lines with `systemctl show` (and systemd
# expands % in them). Registration settings in admin_settings.json override both.
EnvironmentFile=-/etc/cryptirc/cryptirc.env
Environment=RUST_LOG=info
# Plain log lines: journald keeps ANSI colour codes as unreadable "blob data".
Environment=NO_COLOR=1
# ffmpeg + exiftool strip upload metadata; Arch installs exiftool in /usr/bin/vendor_perl.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl

# ── Security hardening ─────────────────────────────────────────────────────────

# Run as unprivileged user (never root)
NoNewPrivileges=true

# Private /tmp — app can't see other processes' temp files
PrivateTmp=true

# Read-only filesystem except explicitly allowed paths
ProtectSystem=strict
ReadWritePaths=/var/lib/cryptirc
ReadWritePaths=/var/log/cryptirc

# Can't see /home, /root directories
ProtectHome=true

# Restrict syscalls to what a typical server app needs
# (prevents exotic exploitation paths)
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# No access to kernel namespaces, module loading, etc.
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true

# Lock down address families — only need TCP/UDP
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Memory execution prevention
# MemoryDenyWriteExecute=true  # Disabled — OpenSSL may need W+X memory

# Capability bounding — app needs no Linux capabilities
CapabilityBoundingSet=
AmbientCapabilities=

# Can't create setuid/setgid files
LockPersonality=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectHostname=true

# Resource limits. TasksMax caps THIS unit's threads (its cgroup); not LimitNPROC, which
# counts every task of the cryptirc UID — irc-core's too — so one service could starve the other.
LimitNOFILE=65536
TasksMax=512

[Install]
WantedBy=multi-user.target
